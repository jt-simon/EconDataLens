# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required. Used for both the Postgres container and the ETL connection string,
# so avoid ';' and '=' in it.
POSTGRES_PASSWORD=

# Required. Sent to BLS in the User-Agent so they can reach you; use an address you control.
BLS_CONTACT_EMAIL=

# Optional (defaults shown).
# POSTGRES_DB=econdatalens
# POSTGRES_USER=econdatalens
# Host port for Postgres, bound to 127.0.0.1 only.
# POSTGRES_PORT=5432
